</category>
<category>
    <pattern>KAUN HAI * KA BAAP</pattern>
    <template><srai>WHO IS FATHER OF <star/></srai></template>
</category>
<category>
    <pattern>* FATHER *</pattern>
    <template><srai>WHO IS FATHER OF <star index="1"/></srai></template>
</category>
<category>
    <pattern>* BAAP *</pattern>
    <template><srai>WHO IS FATHER OF <star index="1"/></srai></template>
</category>

