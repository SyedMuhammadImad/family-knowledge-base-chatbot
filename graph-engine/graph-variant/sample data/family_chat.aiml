<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0">

<!-- ==========================================
     GREETINGS & CORE CONVERSATION
     ========================================== -->
<category>
    <pattern>HI</pattern>
    <template>Hello! I am the Family Knowledge Base assistant. Ask me about any family member or relationship in English or Roman Urdu!</template>
</category>
<category>
    <pattern>HELLO</pattern>
    <template><srai>HI</srai></template>
</category>
<category>
    <pattern>HI THERE</pattern>
    <template><srai>HI</srai></template>
</category>
<category>
    <pattern>HEY</pattern>
    <template><srai>HI</srai></template>
</category>
<category>
    <pattern>BYE</pattern>
    <template>Goodbye! Come back anytime.</template>
</category>
<category>
    <pattern>EXIT</pattern>
    <template>Goodbye!</template>
</category>

<!-- ==========================================
     FATHER QUERIES
     ========================================== -->
<category>
    <pattern>WHO IS FATHER OF *</pattern>
    <template>QUERY:father:<star/></template>
</category>
<category>
    <pattern>WHO IS THE FATHER OF *</pattern>
    <template><srai>WHO IS FATHER OF <star/></srai></template>
</category>
