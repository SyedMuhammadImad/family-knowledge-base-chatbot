<!-- ==========================================
     DEFAULT FALLBACK
     ========================================== -->
<category>
    <pattern>*</pattern>
    <template>Sorry, I did not understand that query format. Try asking naturally in English or Roman Urdu about relationships, profession, city location hubs, age, or meetup recommendations.</template>
</category>

</aiml>