<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0">

<category>
    <pattern>HI</pattern>
    <template>Hello! I am ready to build your knowledge base. Give me facts in English or Roman Urdu, or shorthand commands.</template>
</category>
<category>
    <pattern>HELLO</pattern>
    <template><srai>HI</srai></template>
</category>

