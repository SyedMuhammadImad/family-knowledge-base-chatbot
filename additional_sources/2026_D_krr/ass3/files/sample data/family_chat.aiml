    <template>YESNO:sibling:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>ARE * AND * MARRIED</pattern>
    <template>YESNO:married:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>IS * MARRIED</pattern>
    <template>YESNO:is_married:<star/></template>
</category>
<category>
    <pattern>IS * OLDER THAN *</pattern>
    <template>YESNO:older_than:<star index="1"/>:<star index="2"/></template>
</category>
