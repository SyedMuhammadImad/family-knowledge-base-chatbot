<!-- ==========================================
     YES/NO QUERIES
     ========================================== -->
<category>
    <pattern>IS * FATHER OF *</pattern>
    <template>YESNO:father:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>IS * MOTHER OF *</pattern>
    <template>YESNO:mother:<star index="1"/>:<star index="2"/></template>
</category>
