<!-- ==========================================
     DEFAULT
     ========================================== -->
<category>
    <pattern>*</pattern>
    <template>Sorry, I did not understand that. Try asking about family relationships like father, mother, siblings, grandparents, city, profession, or date of birth.</template>
</category>

