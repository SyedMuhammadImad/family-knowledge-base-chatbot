<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0">

<!-- ==========================================
     GREETINGS
     ========================================== -->
<category>
    <pattern>HI</pattern>
    <template>Hello! I am the Family Knowledge Base assistant. Ask me about any family member!</template>
</category>
<category>
    <pattern>HELLO</pattern>
    <template>Hi there! Ask me about family relationships, birthdays, cities, or professions.</template>
</category>
<category>
    <pattern>HI THERE</pattern>
    <template>Hello! How can I help you with the family knowledge base?</template>
</category>
<category>
    <pattern>HEY</pattern>
    <template>Hey! Ask me anything about the family.</template>
</category>
<category>
    <pattern>BYE</pattern>
    <template>Goodbye! Come back anytime.</template>
</category>
<category>
    <pattern>EXIT</pattern>
    <template>Goodbye!</template>
</category>

<!-- ==========================================
     FATHER QUERIES
     ========================================== -->
