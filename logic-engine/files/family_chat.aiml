<!-- ==========================================
     GREETINGS, CLEARANCE & TERMINATIONS
     ========================================== -->
<category><pattern>HI</pattern><template>Hello! I am the Family Knowledge Base assistant. Ask me about any family member!</template></category>
<category><pattern>HELLO</pattern><template>Hi there! Ask me about family relationships, birthdays, cities, or professions.</template></category>
<category><pattern>HI THERE</pattern><template>Hello! How can I help you with the family knowledge base?</template></category>
<category><pattern>HEY</pattern><template>Hey! Ask me anything about the family.</template></category>
<category><pattern>AOA</pattern><template>Walaikum Assalam! How can I assist you with the family tree today?</template></category>
<category><pattern>ASSALAM O ALAIKUM</pattern><template>Walaikum Assalam! Ask me anything about family relationships or history.</template></category>
<category><pattern>BYE</pattern><template>Goodbye! Come back anytime.</template></category>
<category><pattern>EXIT</pattern><template>Goodbye!</template></category>
<category><pattern>QUIT</pattern><template>Goodbye!</template></category>

