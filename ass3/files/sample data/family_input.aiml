<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0">

<!-- ==========================================
     GREETINGS
     ========================================== -->
<category>
    <pattern>HI</pattern>
    <template>Hello! I can help you add family members to the knowledge base. Try: "Add male Ali" or "Ali is parent of Omar"</template>
</category>
<category>
    <pattern>HELLO</pattern>
    <template>Hi! Tell me about your family. You can say things like "Add female Sara" or "Ali was born in 1978".</template>
</category>
<category>
    <pattern>HELP</pattern>
    <template>You can say:
- "Add male [name]" or "Add female [name]"
- "[name] is parent of [name]"
- "[name] is married to [name]"
- "[name] was born in [year]"
- "[name] lives in [city]"
- "[name] works as [profession]"
- "Show facts" to see what has been added
- "Save facts" to save everything to the knowledge base</template>
</category>

<!-- ==========================================
     ADDING GENDER FACTS
     ========================================== -->
<category>
    <pattern>ADD MALE *</pattern>
    <template>ADDFACT:male:<star/></template>
</category>
<category>
    <pattern>ADD A MALE *</pattern>
    <template>ADDFACT:male:<star/></template>
</category>
<category>
    <pattern>* IS MALE</pattern>
    <template>ADDFACT:male:<star/></template>
</category>
<category>
    <pattern>* IS A MALE</pattern>
    <template>ADDFACT:male:<star/></template>
</category>
<category>
    <pattern>* IS GAY</pattern>
    <template>ADDFACT:orientation:<star/>:gay</template>
</category>
<category>
    <pattern>ADD FEMALE *</pattern>
    <template>ADDFACT:female:<star/></template>
</category>
<category>
    <pattern>ADD A FEMALE *</pattern>
    <template>ADDFACT:female:<star/></template>
</category>
<category>
    <pattern>* IS FEMALE</pattern>
    <template>ADDFACT:female:<star/></template>
</category>
<category>
    <pattern>* IS A FEMALE</pattern>
    <template>ADDFACT:female:<star/></template>
</category>
<category>
    <pattern>ADD PERSON * GENDER MALE</pattern>
    <template>ADDFACT:male:<star/></template>
</category>
<category>
    <pattern>ADD PERSON * GENDER FEMALE</pattern>
    <template>ADDFACT:female:<star/></template>
</category>
<category>
    <pattern>* IS A BOY</pattern>
    <template>ADDFACT:male:<star/></template>
</category>
<category>
    <pattern>* IS A GIRL</pattern>
    <template>ADDFACT:female:<star/></template>
</category>
<category>
    <pattern>* IS A MAN</pattern>
    <template>ADDFACT:male:<star/></template>
</category>
<category>
    <pattern>* IS A WOMAN</pattern>
    <template>ADDFACT:female:<star/></template>
</category>

<!-- ==========================================
     ADDING PARENT FACTS
     ========================================== -->
<category>
    <pattern>* IS PARENT OF *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* IS THE PARENT OF *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* IS FATHER OF *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* IS THE FATHER OF *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* IS MOTHER OF *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* IS THE MOTHER OF *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* HAS A CHILD NAMED *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* HAS CHILD *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>ADD PARENT * OF *</pattern>
    <template>ADDFACT:parent:<star index="1"/>:<star index="2"/></template>
</category>

<!-- ==========================================
     ADDING MARRIAGE FACTS
     ========================================== -->
<category>
    <pattern>* IS MARRIED TO *</pattern>
    <template>ADDFACT:married:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* AND * ARE MARRIED</pattern>
    <template>ADDFACT:married:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* MARRIED *</pattern>
    <template>ADDFACT:married:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>ADD MARRIAGE * AND *</pattern>
    <template>ADDFACT:married:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* IS THE HUSBAND OF *</pattern>
    <template>ADDFACT:married:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* IS THE WIFE OF *</pattern>
    <template>ADDFACT:married:<star index="2"/>:<star index="1"/></template>
</category>

<!-- ==========================================
     ADDING DOB FACTS
     ========================================== -->
<category>
    <pattern>* WAS BORN IN *</pattern>
    <template>ADDFACT:dob:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* IS BORN IN *</pattern>
    <template>ADDFACT:dob:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>DATE OF BIRTH OF * IS *</pattern>
    <template>ADDFACT:dob:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* HAS DATE OF BIRTH *</pattern>
    <template>ADDFACT:dob:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>ADD DOB * *</pattern>
    <template>ADDFACT:dob:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* BIRTH YEAR IS *</pattern>
    <template>ADDFACT:dob:<star index="1"/>:<star index="2"/></template>
</category>
<category>
    <pattern>* WAS BORN *</pattern>
    <template>ADDFACT:dob:<star index="1"/>:<star index="2"/></template>
</category>

