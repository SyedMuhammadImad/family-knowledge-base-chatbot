<!-- ==========================================
     CONTROL COMMANDS
     ========================================== -->
<category>
    <pattern>SHOW FACTS</pattern>
    <template>CONTROL:show</template>
</category>
<category>
    <pattern>SHOW ALL FACTS</pattern>
    <template>CONTROL:show</template>
</category>
<category>
    <pattern>LIST FACTS</pattern>
    <template>CONTROL:show</template>
</category>
<category>
    <pattern>SAVE FACTS</pattern>
    <template>CONTROL:save</template>
</category>
<category>
    <pattern>SAVE</pattern>
    <template>CONTROL:save</template>
</category>
<category>
    <pattern>COMMIT FACTS</pattern>
    <template>CONTROL:save</template>
</category>
<category>
    <pattern>CLEAR FACTS</pattern>
    <template>CONTROL:clear</template>
</category>
<category>
    <pattern>RESET</pattern>
    <template>CONTROL:clear</template>
</category>
<category>
    <pattern>BYE</pattern>
    <template>Goodbye! Your facts have been saved to the knowledge base.</template>
</category>
<category>
    <pattern>EXIT</pattern>
    <template>Goodbye!</template>
</category>

<!-- ==========================================
     DEFAULT
     ========================================== -->
<category>
    <pattern>*</pattern>
    <template>I did not understand that. Type HELP to see what I can do.</template>
</category>

</aiml>
